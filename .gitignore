/.quarto/
/_site/
**/*.quarto_ipynb
.DS_Store
Thumbs.db

# Byte-cache from the tools/ scripts. tools/validate_courses.py runs on
# every render as a Quarto pre-render step, so this reappears constantly.
__pycache__/

# Raw image originals are staged here for processing; never committed.
# See IMAGE_ASSET_PLAN.md.
/assets/images/raw/*
!/assets/images/raw/README.md

# Local planning notes and one-off review bundles. These are excluded
# from the render allowlist (never published) and are kept out of git
# history; the whole folder is local-only.
_site_planning/
